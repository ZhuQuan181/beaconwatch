# RID Server configuration

# ── HTTP server ───────────────────────────────────────────────────────
RID_HTTP_HOST=0.0.0.0
RID_HTTP_PORT=8000

# ── PostgreSQL with PostGIS + TimescaleDB ─────────────────────────────
# Port 5433 on the host because 5432 is taken by the system PostgreSQL.
RID_DB_HOST=localhost
RID_DB_PORT=5433
RID_DB_NAME=rid
RID_DB_USER=rid
RID_DB_PASSWORD=rid_dev_password
RID_DB_POOL_MIN=2
RID_DB_POOL_MAX=10

# ── MQTT broker (EMQX) ────────────────────────────────────────────────
RID_MQTT_HOST=localhost
RID_MQTT_PORT=1883
RID_MQTT_USERNAME=
RID_MQTT_PASSWORD=
RID_MQTT_CLIENT_ID=rid-server
RID_MQTT_OBS_TOPIC=rid/v1/+/obs
RID_MQTT_QOS=1

# ── Operational ───────────────────────────────────────────────────────
RID_LOG_LEVEL=INFO
RID_ENV=dev
