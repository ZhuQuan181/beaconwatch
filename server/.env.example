# RID Server configuration

# ── HTTP server ───────────────────────────────────────────────────────
RID_HTTP_HOST=0.0.0.0
RID_HTTP_PORT=8000
# Optional. Empty keeps the local/demo API open. When set, data routes and
# WebSockets require this Bearer token; health and metrics stay public.
# This compatibility credential is an administrator.
RID_API_TOKEN=
# Preferred production identity source. JSON file containing named API
# principals, roles and SHA-256 key digests. When set, all data routes
# require a key from this file (or the legacy token above).
RID_AUTH_USERS_FILE=
# Pick up key additions/revocations without restarting the API.
RID_AUTH_RELOAD_INTERVAL_S=5
# Optional comma-separated browser origins, e.g. https://ops.example.com
RID_CORS_ORIGINS=
RID_WS_PING_INTERVAL_S=20
# /drones/unidentified defaults to this recent window instead of a full scan.
RID_UNIDENTIFIED_LOOKBACK_S=604800

# ── PostgreSQL + TimescaleDB ──────────────────────────────────────────
# Port 5433 on the host because 5432 is taken by the system PostgreSQL.
RID_DB_HOST=localhost
RID_DB_PORT=5433
RID_DB_NAME=rid
RID_DB_USER=rid
RID_DB_PASSWORD=rid_dev_password
RID_DB_POOL_MIN=2
RID_DB_POOL_MAX=10
# Container entrypoint retries Alembic while PostgreSQL is still
# completing startup/recovery after its readiness probe turns green.
RID_MIGRATION_MAX_ATTEMPTS=20
RID_MIGRATION_RETRY_BASE_S=1
RID_MIGRATION_RETRY_MAX_S=10

# ── MQTT broker (EMQX) ────────────────────────────────────────────────
RID_MQTT_HOST=localhost
RID_MQTT_PORT=1883
RID_MQTT_USERNAME=
RID_MQTT_PASSWORD=
RID_MQTT_TLS=false
# Required only for private CAs / mutual TLS. When TLS is enabled and no CA
# is supplied, the system trust store is used.
RID_MQTT_CA_CERT=
RID_MQTT_CLIENT_CERT=
RID_MQTT_CLIENT_KEY=
RID_MQTT_CLIENT_ID=rid-server
RID_MQTT_OBS_TOPIC=rid/v1/+/obs
RID_MQTT_INFO_TOPIC=rid/v1/+/info
# Set the same group on every API replica to share MQTT delivery. Leave
# empty for a single API process. Example: beaconwatch-prod
RID_MQTT_SHARED_GROUP=
RID_MQTT_QOS=1
# Unique per API replica; appended to the MQTT client id. Empty defaults
# to "<hostname>-<pid>", so a Compose variable left unset is still unique.
RID_INSTANCE_ID=

# ── Live WebSocket fan-out ────────────────────────────────────────────
# Use "redis" when running more than one API replica behind a load
# balancer, together with RID_MQTT_SHARED_GROUP. Memory mode is correct
# for a single process.
RID_BUS_BACKEND=memory
RID_REDIS_URL=redis://localhost:6379/0
RID_REDIS_CHANNEL=beaconwatch:events
# true makes readiness return 503 while Redis is unavailable; the server
# still starts and retries, and local WebSocket clients keep receiving.
RID_REDIS_REQUIRED=false
RID_REDIS_CONNECT_TIMEOUT_S=3
RID_REDIS_PUBLISH_TIMEOUT_S=1
# Maximum idle Pub/Sub read before the listener rechecks stop/reconnect
# state. This is not a socket timeout.
RID_REDIS_POLL_TIMEOUT_S=1
RID_REDIS_RECONNECT_MAX_S=30

# ── Alert rules ───────────────────────────────────────────────────────
RID_ALERT_MAX_ALT_M=120
RID_ALERT_UNIDENTIFIED=true
RID_ALERT_DEDUP_SECONDS=120
# Zero keeps audit data forever. Set a positive number of days to opt in
# to resolved-alert cleanup; pending webhook deliveries always protect
# their parent alert.
RID_ALERT_RETENTION_DAYS=0
RID_NOTIFICATION_RETENTION_DAYS=0
RID_RETENTION_INTERVAL_S=3600
RID_RETENTION_BATCH_SIZE=500

# ── Alert notification webhook ───────────────────────────────────────
# Empty URL disables durable webhook notifications. When enabled, the
# secret is mandatory and signs each delivery (HMAC-SHA256).
RID_NOTIFY_WEBHOOK_URL=
RID_NOTIFY_WEBHOOK_SECRET=
RID_NOTIFY_WEBHOOK_TIMEOUT_S=10
RID_NOTIFY_WEBHOOK_TRUST_ENV=false
RID_NOTIFY_WORKER_INTERVAL_S=1
RID_NOTIFY_BATCH_SIZE=20
RID_NOTIFY_CONCURRENCY=4
RID_NOTIFY_MAX_ATTEMPTS=8
RID_NOTIFY_BASE_BACKOFF_S=2
RID_NOTIFY_MAX_BACKOFF_S=300

# ── Operational ───────────────────────────────────────────────────────
RID_LOG_LEVEL=INFO
RID_ENV=dev
