{
  "name": "beaconwatch-frontend",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "BeaconWatch — real-time Remote ID dashboard (Vite + React + MapLibre GL).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mock": "vite build --config vite.mock.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
