# Public listener ports. The HTTP listener redirects to HTTPS.
BW_HTTP_PORT=80
BW_HTTPS_PORT=443

# Keep MQTT off every public interface. Use a VPN/private interface for
# remote receivers, or change this to a private host address.
BW_MQTT_BIND_IP=127.0.0.1
BW_MQTT_PUBLISH_PORT=1883
BW_MQTT_SHARED_GROUP=beaconwatch-prod

BW_SERVER_IMAGE=beaconwatch-server:1.0.0
BW_PROXY_IMAGE=beaconwatch-proxy:1.0.0
BW_API_REPLICAS=2

BW_DB_NAME=beaconwatch
BW_DB_USER=beaconwatch
BW_DB_PASSWORD_FILE=./secrets/db_password
BW_REDIS_PASSWORD_FILE=./secrets/redis_password
BW_REDIS_URL_FILE=./secrets/redis_url
BW_AUTH_USERS_FILE=./secrets/auth_users.json
BW_WEBHOOK_SECRET_FILE=./secrets/webhook_secret
BW_VIEWER_API_TOKEN_FILE=./secrets/viewer_api_token

RID_LOG_LEVEL=INFO
RID_ALERT_RETENTION_DAYS=365
RID_NOTIFICATION_RETENTION_DAYS=90
RID_RETENTION_INTERVAL_S=3600
RID_RETENTION_BATCH_SIZE=500

# Leave empty to disable webhook notifications.
RID_NOTIFY_WEBHOOK_URL=
RID_NOTIFY_MAX_ATTEMPTS=8
RID_NOTIFY_BASE_BACKOFF_S=2
RID_NOTIFY_MAX_BACKOFF_S=300
